meta {
  name: 04 - Histórico con Filtros (zona + tipo)
  type: http
  seq: 4
}

get {
  url: https://ec2-18-225-226-38.us-east-2.compute.amazonaws.com/api/historico?zona=sur&tipo=contador
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  zona: sur
  tipo: contador
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("respuesta es array", function() {
    expect(res.body).to.be.an("array");
  });
}
